{
  "name": "kitcut",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, unstyled React building blocks for in-browser record → edit → export.",
  "license": "MIT",
  "author": "Serhii Troinin",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "build": "turbo run build",
